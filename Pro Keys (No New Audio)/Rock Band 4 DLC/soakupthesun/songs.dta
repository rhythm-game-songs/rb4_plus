			{$world iterate PostProc $p
			{$p set saturation 100}}
		}
		{do
			{$world iterate PostProc $p
			{$p set bloom_intensity 10}}
		}
		{do
			{$world iterate PostProc $p
			{$p set hue 10}}
		}
	)
   (song
      (name         "songs/soakupthesun/soakupthesun")
